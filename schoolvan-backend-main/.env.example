# Server Port
PORT=10000

# MongoDB Connection String (MongoDB Atlas in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ReactSchoolvan?retryWrites=true&w=majority

# Session Secret Key
SESSION_SECRET=schoolvan_secure_secret_key_2026

# Production Environment
NODE_ENV=production

# Frontend Origin URL (Optional, *.vercel.app & *.netlify.app are automatically permitted)
FRONTEND_URL=https://schoolvan-frontend.vercel.app
